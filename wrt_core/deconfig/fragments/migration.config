# Incremental ER01 migration requirements; original fragments stay unchanged.
# CDC Ethernet selects usbnet/mii normally. Real HiLink mode still needs testing.
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
# Existing ShellCrash/Tailscale custom chains use the cn_ip set.
CONFIG_PACKAGE_ipset=y
# ArkBridge is restored later, disabled first, with its own private configuration.
CONFIG_PACKAGE_python3-base=y
CONFIG_PACKAGE_python3-urllib=y
CONFIG_PACKAGE_python3-openssl=y
