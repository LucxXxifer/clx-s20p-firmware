			if (FC->SubType == SUBTYPE_ACTION) {
				unsigned int suppressed;

				if (pmf_action_log_allow(jiffies, &suppressed))
					MTWF_DBG(pAd, DBG_CAT_SEC, CATSEC_PMF, DBG_LVL_WARN,
						"PMF NR_UCAST global suppressed=%u%s SubType=%u WCID=%u\n",
						suppressed, suppressed == ~0U ? "+" : "",
						FC->SubType, pRxBlk->wcid);
			} else {
				MTWF_DBG(pAd, DBG_CAT_SEC, CATSEC_PMF, DBG_LVL_ERROR,
						 "[PMF] : NOT_ROBUST_UNICAST_FRAME, FC->SubType=%d (wcid=%d)\n",
						  FC->SubType, pRxBlk->wcid);
			}
