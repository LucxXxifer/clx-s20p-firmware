 #ifdef DOT11W_PMF_SUPPORT
 
 #include "rt_config.h"
+
+/* Bound only the AP action-frame diagnostic; rejection policy is unchanged.
+ * One global bucket across radios/peers, never keyed by reusable WCID.
+ * A saturated count is a lower bound. Pending counts need another event to print.
+ */
+#include <linux/jiffies.h>
+#include <linux/spinlock.h>
+
+static DEFINE_SPINLOCK(pmf_action_log_lock);
+static unsigned long pmf_action_log_next;
+static unsigned int pmf_action_log_suppressed;
+static bool pmf_action_log_started;
+
+static bool pmf_action_log_allow(unsigned long now, unsigned int *suppressed)
+{
+	unsigned long flags;
+	bool emit = false;
+
+	spin_lock_irqsave(&pmf_action_log_lock, flags);
+	if (!pmf_action_log_started || time_after_eq(now, pmf_action_log_next)) {
+		*suppressed = pmf_action_log_suppressed;
+		pmf_action_log_suppressed = 0;
+		pmf_action_log_next = now + 5 * HZ;
+		pmf_action_log_started = true;
+		emit = true;
+	} else if (pmf_action_log_suppressed != ~0U) {
+		pmf_action_log_suppressed++;
+	}
+	spin_unlock_irqrestore(&pmf_action_log_lock, flags);
+	return emit;
+}
+/* End bounded PMF diagnostic. */
 
 UCHAR OUI_PMF_BIP_CMAC_128_CIPHER[4] = {0x00, 0x0F, 0xAC, 0x06};
 UCHAR OUI_PMF_BIP_CMAC_256_CIPHER[4] = {0x00, 0x0F, 0xAC, 0x0d};
