# Optional same-build packages: m builds signed-repository packages, not ROM installs.
# The existing HiLink CDC-ECM root stays y in migration.config.
CONFIG_PACKAGE_kmod-usb-net-rndis=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=m
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=m
# AT/control ports and native modem interfaces.
CONFIG_PACKAGE_kmod-usb-serial-option=m
CONFIG_PACKAGE_kmod-usb-serial-wwan=m
CONFIG_PACKAGE_kmod-usb-acm=m
CONFIG_PACKAGE_kmod-usb-wdm=m
# Mode-specific netifd control utilities and LuCI interface protocols.
CONFIG_PACKAGE_uqmi=m
CONFIG_PACKAGE_umbim=m
CONFIG_PACKAGE_comgt=m
CONFIG_PACKAGE_comgt-ncm=m
CONFIG_PACKAGE_luci-proto-qmi=m
CONFIG_PACKAGE_luci-proto-mbim=m
CONFIG_PACKAGE_luci-proto-ncm=m
CONFIG_PACKAGE_luci-proto-3g=m
# Use a mode switch only when real USB descriptors show it is necessary.
CONFIG_PACKAGE_usb-modeswitch=m
# Inspection tools, not automatically started modem managers.
CONFIG_PACKAGE_usbutils=m
CONFIG_PACKAGE_picocom=m

# Common USB Ethernet adapters, including RTL8156/RTL8156B 2.5GbE.
# Hardware model/chipset still needs real USB ID and negotiated-rate verification.
CONFIG_PACKAGE_kmod-usb-net-rtl8152=m
CONFIG_PACKAGE_kmod-usb-net-asix=m
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=m
CONFIG_PACKAGE_kmod-usb-net-aqc111=m
CONFIG_PACKAGE_kmod-usb-net-lan78xx=m
CONFIG_PACKAGE_kmod-usb-net-smsc75xx=m
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=m
